<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared Palette #57 UI kit -->

    <style name="Widget.Tag.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary_mid</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Tag.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary_mid</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Tag.Button.DangerText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:minWidth">0dp</item>
        <item name="rippleColor">@color/danger_bg</item>
    </style>

    <style name="Widget.Tag.Button.DangerOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/danger_bg</item>
    </style>

    <style name="Widget.Tag.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
